{
  "name": "genkit-channels",
  "version": "0.1.0",
  "description": "Experimental CLI and helper library for exposing a Genkit app's flows and agents over a transport (a \"channel\"), running the app in a box (subprocess, sandbox, container, or remote runtime) via @genkit-ai/box.",
  "license": "Apache-2.0",
  "keywords": [
    "genkit",
    "ai",
    "genai",
    "deploy",
    "channel"
  ],
  "type": "commonjs",
  "bin": {
    "genkit-channel": "dist/bin/genkit-channel.js",
    "genkit-channels": "dist/bin/genkit-channel.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent-dir": {
      "types": "./dist/agent-dir/index.d.ts",
      "default": "./dist/agent-dir/index.js"
    }
  },
  "files": [
    "dist/",
    "channels/"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "smoke": "node test/smoke.mjs",
    "test": "node test/config.mjs && node test/secrets.mjs && node test/smoke.mjs && node test/agent.mjs && node test/box-routing.mjs && node test/real-app.mjs && npm run test:units && node test/packaging.mjs && node test/service-settings.mjs",
    "test:live": "node test/agent-dir.mjs && node test/live.mjs",
    "test:units": "node test/build-channel-units.mjs && node test/discord-bridge.mjs && node test/slack.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@genkit-ai/ai": "^1.43.0-rc.1",
    "@genkit-ai/anthropic": "^0.6.0-rc.1",
    "@genkit-ai/box": "0.0.1-dev.2",
    "@genkit-ai/compat-oai": "^1.43.0-rc.1",
    "@genkit-ai/google-genai": "^1.43.0-rc.1",
    "@genkit-ai/middleware": "^0.11.0-rc.1",
    "axios": "^1.7.7",
    "commander": "^11.1.0",
    "extract-zip": "^2.0.1",
    "genkit": "^1.43.0-rc.1",
    "jsonata": "^2.0.5",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3",
    "ws": "^8.18.0"
  }
}
