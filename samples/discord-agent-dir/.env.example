# The bot token from the Discord developer portal
# (Applications -> your app -> Bot -> Reset Token).
DISCORD_TOKEN=

# Credentials for the model provider. This sample uses Google AI (Gemini);
# get a key from https://aistudio.google.com/apikey. Set OPENAI_API_KEY or
# ANTHROPIC_API_KEY instead to use those providers (only providers whose key is
# present are registered).
GEMINI_API_KEY=
