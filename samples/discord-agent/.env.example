# Copy to .env.local (gitignored) and fill in. genkit-channel reads .env,
# .env.local, .env.<deployment> and .env.<deployment>.local, in that order;
# variables already set in your shell win.

# The bot token from the Discord developer portal
# (Applications -> your app -> Bot -> Reset Token).
DISCORD_TOKEN=

# Credentials for the model provider. This sample uses Google AI (Gemini);
# get a key from https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Slack (slack-bot deployment). See channels/slack-socket/README.md.
# Bot User OAuth Token (Install App page).
SLACK_BOT_TOKEN=
# App-level token with connections:write (Basic Information page).
SLACK_APP_TOKEN=
