# Copy to .env.local (gitignored) and fill in. genkit-channel reads .env,
# .env.local, .env.<deployment> and .env.<deployment>.local, in that order;
# variables already set in your shell win.

# Get a key from https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# What callers send as `Authorization: Bearer <key>`. Any long random string,
# e.g. `openssl rand -hex 24`.
API_KEY=
